#!/bin/sh
# al - a tiny persistent alias manager for bash/zsh
#   al set sh12 ssh server12      -> typing `sh12` runs `ssh server12`
#   al unset sh12 / al show / al clean
# Data: $AL_HOME/aliases.tsv  (name<TAB>created<TAB>expires<TAB>last_used<TAB>command)
set -eu

AL_VERSION="0.1.0"
AL_HOME="${AL_HOME:-$HOME/.al}"
AL_DB="${AL_DB:-$AL_HOME/aliases.tsv}"
AL_STALE_DAYS="${AL_STALE_DAYS:-30}"
TAB=$(printf '\t')

die()  { printf 'al: %s\n' "$*" >&2; exit 1; }
info() { [ "${QUIET:-0}" = 1 ] || printf '%s\n' "$*"; }
now()  { date +%s; }

ensure_db() {
  [ -d "$AL_HOME" ] || mkdir -p "$AL_HOME"
  [ -f "$AL_DB" ] || : > "$AL_DB"
}

fmt_time() {
  case "$1" in ''|0) printf -- '-'; return;; esac
  date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$1" '+%Y-%m-%d %H:%M'
}

# 90 / 30s / 15m / 12h / 7d / 2w -> seconds
parse_dur() {
  n=${1%[smhdw]}; u=${1#"$n"}
  case "$n" in ''|*[!0-9]*) return 1;; esac
  case "$u" in ''|s) m=1;; m) m=60;; h) m=3600;; d) m=86400;; w) m=604800;; *) return 1;; esac
  echo $((n * m))
}

# replace db atomically with stdin
write_db() {
  tmp=$(mktemp "$AL_DB.XXXXXX")
  sort -t "$TAB" -k1,1 > "$tmp"
  mv "$tmp" "$AL_DB"
}

has_name() { awk -F'\t' -v n="$1" '$1==n{f=1} END{exit !f}' "$AL_DB"; }

valid_name() {
  case "$1" in
    ''|[0-9-]*|*[!A-Za-z0-9_-]*) return 1;;
  esac
  return 0
}

# names that must never be shadowed
is_reserved() {
  case " $1 " in
    *" al "*|*" set "*|*" unset "*|*" alias "*|*" unalias "*|*" cd "*|*" exit "*|\
    *" export "*|*" source "*|*" eval "*|*" exec "*|*" builtin "*|*" command "*|\
    *" function "*|*" return "*|*" local "*|*" read "*|*" echo "*|*" printf "*|\
    *" test "*|*" type "*|*" trap "*|*" shift "*|*" wait "*|*" kill "*|*" jobs "*|\
    *" fg "*|*" bg "*|*" if "*|*" then "*|*" else "*|*" fi "*|*" for "*|*" while "*|\
    *" do "*|*" done "*|*" case "*|*" esac "*|*" sudo "*|*" ssh "*|*" sh "*|\
    *" bash "*|*" zsh "*|*" ls "*|*" rm "*|*" cp "*|*" mv "*|*" cat "*|*" env "*)
      return 0;;
  esac
  return 1
}

usage() {
  cat <<'EOF'
al - persistent command aliases for bash/zsh

Usage:
  al set [-t TTL] [-f] NAME [as] COMMAND...   add / overwrite an alias
  al unset NAME...                            remove alias(es)       (alias: rm)
  al show [PATTERN]                           list aliases           (alias: ls)
  al clean [--unused DUR] [-n] [-q]           drop expired (and long-unused) aliases
  al export                                   print db (TSV) to stdout
  al import [FILE|-]                          merge aliases from TSV (same name overwritten)
  al update                                   re-run the installer to upgrade
  al version | help

Options:
  -t, --ttl DUR    expire after DUR, e.g. 30m 12h 7d 2w
  -f, --force      allow shadowing an existing command in PATH
  --unused DUR     with clean: also drop aliases not used for DUR
  -n, --dry-run    with clean: only print what would be removed

Examples:
  al set sh12 ssh server12                  # then: sh12  (extra args pass through: sh12 -p 2222)
  al set sh12 as ssh server12               # 'as' is optional
  al set status 'make -C /mnt/pubchain/starter cluster-status'
  al set st '(cd /mnt/pubchain/starter && make cluster-status)'   # multi-step, cwd unchanged
  al set -t 7d logs 'tail -f /data/reth/reth.log | grep -i error'
  al set g "grep 'state root' reth.log"     # command has ' -> wrap with "
  al show status
  al unset status st
  al clean --unused 90d
  al export | ssh server12 '~/.al/bin/al import -'

Quoting:
  If COMMAND contains  &&  ||  ;  |  >  <  $  *  wrap it in single quotes,
  otherwise your shell splits it before al sees it:
    al set status cd /x && make y      # WRONG: only 'cd /x' is saved, make runs now
    al set status 'cd /x && make y'    # RIGHT (note: leaves you in /x afterwards)
EOF
}

cmd_set() {
  ttl=""; force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--ttl) [ $# -ge 2 ] || die "--ttl needs a value"; ttl=$2; shift 2;;
      --ttl=*)  ttl=${1#*=}; shift;;
      -f|--force) force=1; shift;;
      --) shift; break;;
      -*) die "unknown option: $1";;
      *) break;;
    esac
  done
  [ $# -ge 2 ] || die "usage: al set [-t TTL] [-f] NAME [as] COMMAND..."
  name=$1; shift
  [ "$1" = "as" ] && [ $# -ge 2 ] && shift
  cmd=$*
  valid_name "$name" || die "invalid name '$name' (allowed: letters, digits, _ and -; must not start with digit or -)"
  is_reserved "$name" && die "'$name' is reserved, pick another name"
  case "$cmd" in *"
"*) die "command must be a single line";; esac
  cmd=$(printf '%s' "$cmd" | tr '\t' ' ')
  ensure_db
  if [ "$force" = 0 ] && ! has_name "$name" && command -v "$name" >/dev/null 2>&1; then
    die "'$name' already exists ($(command -v "$name")); use -f to shadow it"
  fi
  t=$(now); exp=0
  if [ -n "$ttl" ]; then
    s=$(parse_dur "$ttl") || die "bad TTL '$ttl' (use e.g. 30m 12h 7d 2w)"
    exp=$((t + s))
  fi
  { awk -F'\t' -v n="$name" '$1!=n' "$AL_DB"
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$t" "$exp" 0 "$cmd"
  } | write_db
  if [ "$exp" -gt 0 ]; then info "set: $name -> $cmd  (expires $(fmt_time "$exp"))"
  else info "set: $name -> $cmd"; fi
}

cmd_unset() {
  [ $# -ge 1 ] || die "usage: al unset NAME..."
  ensure_db; rc=0
  for name in "$@"; do
    if has_name "$name"; then
      awk -F'\t' -v n="$name" '$1!=n' "$AL_DB" | write_db
      info "unset: $name"
    else
      printf 'al: no such alias: %s\n' "$name" >&2; rc=1
    fi
  done
  return $rc
}

cmd_show() {
  ensure_db
  pat=${1:-}
  t=$(now); stale=$((AL_STALE_DAYS * 86400))
  if [ -t 1 ]; then Y=$(printf '\033[33m'); R=$(printf '\033[31m'); B=$(printf '\033[1m'); Z=$(printf '\033[0m')
  else Y=""; R=""; B=""; Z=""; fi
  if [ ! -s "$AL_DB" ]; then info "(no aliases yet — try: al set sh12 ssh server12)"; return 0; fi
  printf '%s%-14s %-8s %-16s %-16s %s%s\n' "$B" NAME STATUS LAST_USED EXPIRES COMMAND "$Z"
  total=0
  while IFS="$TAB" read -r n c e u cmd; do
    [ -n "$n" ] || continue
    if [ -n "$pat" ]; then case "$n $cmd" in *"$pat"*) ;; *) continue;; esac; fi
    ref=$u; [ "$ref" -gt 0 ] || ref=$c
    if [ "$e" -gt 0 ] && [ "$e" -le "$t" ]; then st=expired; col=$R
    elif [ $((t - ref)) -ge "$stale" ]; then st=stale; col=$Y
    else st=ok; col=""; fi
    printf '%s%-14s %-8s %-16s %-16s %s%s\n' "$col" "$n" "$st" "$(fmt_time "$u")" "$(fmt_time "$e")" "$cmd" "${col:+$Z}"
    total=$((total + 1))
  done < "$AL_DB"
  info "-- $total alias(es); stale = unused >= ${AL_STALE_DAYS}d; db: $AL_DB"
}

cmd_clean() {
  unused=""; dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --unused) [ $# -ge 2 ] || die "--unused needs a value"; unused=$2; shift 2;;
      --unused=*) unused=${1#*=}; shift;;
      -n|--dry-run) dry=1; shift;;
      -q|--quiet) QUIET=1; shift;;
      --expired) shift;;   # default behaviour, kept for readability
      *) die "unknown option: $1";;
    esac
  done
  ensure_db
  u_s=0
  if [ -n "$unused" ]; then u_s=$(parse_dur "$unused") || die "bad duration '$unused'"; fi
  t=$(now)
  drop=$(awk -F'\t' -v t="$t" -v us="$u_s" '
    { ref = ($4 > 0) ? $4 : $2
      if ($3 > 0 && $3 <= t)            print $1 "\texpired\t" $5
      else if (us > 0 && t - ref >= us) print $1 "\tunused\t" $5 }' "$AL_DB")
  if [ -z "$drop" ]; then info "clean: nothing to remove"; return 0; fi
  printf '%s\n' "$drop" | while IFS="$TAB" read -r n why cmd; do
    if [ "$dry" = 1 ]; then info "would remove: $n ($why) -> $cmd"; else info "removed: $n ($why) -> $cmd"; fi
  done
  [ "$dry" = 1 ] && return 0
  names=$(printf '%s\n' "$drop" | cut -f1 | tr '\n' ' ')
  awk -F'\t' -v drop="$names" 'BEGIN{n=split(drop,a," "); for(i=1;i<=n;i++) d[a[i]]=1} !($1 in d)' "$AL_DB" | write_db
}

cmd_import() {
  src=${1:--}
  ensure_db
  if [ "$src" = "-" ]; then in=$(cat); else [ -f "$src" ] || die "no such file: $src"; in=$(cat "$src"); fi
  in=$(printf '%s\n' "$in" | awk -F'\t' 'NF>=5 && $1 ~ /^[A-Za-z_][A-Za-z0-9_-]*$/')
  [ -n "$in" ] || die "nothing to import (expect TSV produced by 'al export')"
  names=$(printf '%s\n' "$in" | cut -f1 | tr '\n' ' ')
  { awk -F'\t' -v drop="$names" 'BEGIN{n=split(drop,a," "); for(i=1;i<=n;i++) d[a[i]]=1} !($1 in d)' "$AL_DB"
    printf '%s\n' "$in"
  } | write_db
  info "imported $(printf '%s\n' "$in" | wc -l | tr -d ' ') alias(es)"
}

# ---- internal: used by shell integration -------------------------------
cmd_touch() {
  [ -f "$AL_DB" ] || return 0
  t=$(now)
  awk -F'\t' -v OFS='\t' -v n="$1" -v t="$t" '$1==n{$4=t} {print}' "$AL_DB" | write_db
}

# emit shell function definitions for all live aliases
cmd_defs() {
  ensure_db
  t=$(now)
  awk -F'\t' -v t="$t" -v q="'" '
    !($3 > 0 && $3 <= t) && $1 != "" {
      c = $5; gsub(q, q "\\" q q, c)
      printf "unalias %s 2>/dev/null; function %s { _al_touch %s; eval %s%s \"$@\"%s; }\n", $1, $1, $1, q, c, q
      names = names " " $1
    }
    END { printf "_AL_NAMES=%s%s%s\n", q, names, q }' "$AL_DB"
}

cmd_update() {
  src="$AL_HOME/.source"
  [ -f "$src" ] || die "unknown install source; re-run install.sh manually"
  # shellcheck disable=SC1090
  . "$src"
  url="${AL_RAW_BASE}/install.sh"
  info "updating from $url"
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$url" | AL_REPO="$AL_REPO" AL_REF="$AL_REF" AL_RAW_BASE="$AL_RAW_BASE" bash
  else wget -qO- "$url" | AL_REPO="$AL_REPO" AL_REF="$AL_REF" AL_RAW_BASE="$AL_RAW_BASE" bash; fi
}

sub=${1:-show}; [ $# -gt 0 ] && shift
case "$sub" in
  set|add)        cmd_set "$@";;
  unset|rm|del)   cmd_unset "$@";;
  show|ls|list)   cmd_show "$@";;
  clean)          cmd_clean "$@";;
  export)         ensure_db; cat "$AL_DB";;
  import)         cmd_import "$@";;
  update|upgrade) cmd_update;;
  version|-v|--version) echo "al $AL_VERSION";;
  help|-h|--help) usage;;
  _touch)         cmd_touch "$1";;
  _defs)          cmd_defs;;
  *) printf 'al: unknown command: %s\n\n' "$sub" >&2; usage >&2; exit 1;;
esac
